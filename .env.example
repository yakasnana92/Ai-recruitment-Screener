# VITE_GROQ_API_KEY: Required for Groq AI API calls from this Vite frontend.
# Create an API key in the Groq console and set it here.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# Optional: override the model used for evaluation.
# Examples: "openai/gpt-oss-20b", "openai/gpt-oss-120b"
VITE_GROQ_MODEL="openai/gpt-oss-20b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
